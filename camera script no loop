UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.Q then
		if frontActive then
			targetPlayer(-14)
			StarterGui:SetCore("SendNotification", {
				Title = "Target",
				Text = "Fired front!",
				Duration = 1
			})
		elseif backActive then
			targetPlayer(8)
			StarterGui:SetCore("SendNotification", {
				Title = "Target",
				Text = "Fired back!",
				Duration = 1
			})
		elseif orbitActive then
			targetAllDirections()
			StarterGui:SetCore("SendNotification", {
				Title = "Target",
				Text = "Fired all directions!",
				Duration = 1
			})
		end
	end
end)
