-- Find players using partial name (returns table of players)
local function findPlayers(input)
	input = string.lower(input)
	local matches = {}

	if input == "all" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				table.insert(matches, player)
			end
		end
		return matches
	end

	if input == "me" then
		table.insert(matches, LocalPlayer)
		return matches
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local username = string.lower(player.Name)
			if string.sub(username, 1, #input) == input then
				table.insert(matches, player)
				break
			end
		end
	end

	return matches
end



-- Target function - handles single offset
local function targetPlayer(offset)
	local targets = findPlayers(box.Text)

	for _, target in ipairs(targets) do
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = target.Character.HumanoidRootPart
			local position = hrp.CFrame * CFrame.new(0, 0, offset)

			CameraEvent:FireServer({
				cf = position
			})
		end
	end
end



-- All directions (orbit) - EXACTLY 1 circle, 8 points at 19 stud radius
local allDirections = {
	Vector3.new(0, 0, -19),          -- Front (0°)
	Vector3.new(13.44, 0, -13.44),   -- Front-Right (45°)
	Vector3.new(19, 0, 0),           -- Right (90°)
	Vector3.new(13.44, 0, 13.44),    -- Back-Right (135°)
	Vector3.new(0, 0, 19),           -- Back (180°)
	Vector3.new(-13.44, 0, 13.44),   -- Back-Left (225°)
	Vector3.new(-19, 0, 0),          -- Left (270°)
	Vector3.new(-13.44, 0, -13.44),  -- Front-Left (315°)
}

-- Linespamm positions - 5 lines spread left/right
local linespammPositions = {
	Vector3.new(-20, 0, -14),  -- Far Left
	Vector3.new(-10, 0, -14),  -- Left
	Vector3.new(0, 0, -14),    -- Center
	Vector3.new(10, 0, -14),   -- Right
	Vector3.new(20, 0, -14),   -- Far Right
}

-- Fire in all directions at once - camera looks AWAY from player
local function targetAllDirections()
	local targets = findPlayers(box.Text)

	for _, target in ipairs(targets) do
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = target.Character.HumanoidRootPart
			
			for _, offset in ipairs(allDirections) do
				local cameraPos = hrp.Position + (hrp.CFrame.RightVector * offset.X) + (hrp.CFrame.UpVector * offset.Y) + (hrp.CFrame.LookVector * offset.Z)
				
				local direction = (cameraPos - hrp.Position).Unit
				
				local lookAwayCF = CFrame.new(cameraPos, cameraPos + direction)

				CameraEvent:FireServer({
					cf = lookAwayCF
				})
			end
		end
	end
end

-- Fire linespamm - 5 lines spread out
local function targetLinespamm()
	local targets = findPlayers(box.Text)

	for _, target in ipairs(targets) do
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = target.Character.HumanoidRootPart
			
			for _, offset in ipairs(linespammPositions) do
				local position = hrp.CFrame * CFrame.new(offset.X, offset.Y, offset.Z)
				
				CameraEvent:FireServer({
					cf = position
				})
			end
		end
	end
end



