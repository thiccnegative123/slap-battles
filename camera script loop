-- Orbit positions - camera circles around player looking AWAY from them
-- Direction: Front → Front-Right → Right → Back-Right → Back → Back-Left → Left → Front-Left
local orbitPositions = {
	{pos = Vector3.new(0, 0, -14), name = "Front"},         -- Front
	{pos = Vector3.new(10, 0, -10), name = "Front-Right"},  -- Front-Right
	{pos = Vector3.new(14, 0, 0), name = "Right"},          -- Right
	{pos = Vector3.new(8, 0, 6), name = "Back-Right"},       -- Back-Right
	{pos = Vector3.new(0, 0, 8), name = "Back"},            -- Back
	{pos = Vector3.new(-8, 0, 6), name = "Back-Left"},      -- Back-Left
	{pos = Vector3.new(-14, 0, 0), name = "Left"},          -- Left
	{pos = Vector3.new(-10, 0, -10), name = "Front-Left"},  -- Front-Left
}

local orbitLoop = false
local currentOrbitIndex = 1



-- Find player using partial name (returns table of players)
local function findPlayers(input)
	input = string.lower(input):gsub("^%s+", ""):gsub("%s+$", "")
	local matches = {}

	-- Type "me" to target yourself (checked FIRST, returns immediately)
	if input == "me" then
		table.insert(matches, LocalPlayer)
		return matches
	end

	-- Type "all" to target everyone except yourself
	if input == "all" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				table.insert(matches, player)
			end
		end
		return matches
	end

	-- Skip empty input
	if #input == 0 then
		return matches
	end

	-- Partial name match (first matching player only, excludes LocalPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local username = string.lower(player.Name)
			if string.sub(username, 1, #input) == input then
				table.insert(matches, player)
				break
			end
		end
	end

	return matches
end



-- Target function - handles front/back offsets
local function targetPlayer(offset)
	local targets = findPlayers(box.Text)

	for _, target in ipairs(targets) do
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = target.Character.HumanoidRootPart
			-- Position offset relative to player
			local position = hrp.CFrame * CFrame.new(0, 0, offset)

			CameraEvent:FireServer({
				cf = position
			})
		end
	end
end



-- LOOP SYSTEM

local frontLoop = false
local backLoop = false


local function startLoop(offset, check)
	while check() do
		targetPlayer(offset)
		task.wait()
	end
end


local function startOrbitLoop(check)
	while check() do
		local targets = findPlayers(box.Text)
		local currentPos = orbitPositions[currentOrbitIndex]
		
		for _, target in ipairs(targets) do
			if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = target.Character.HumanoidRootPart
				
				-- Calculate position around player
				local offset = currentPos.pos
				local cameraPos = hrp.Position + (hrp.CFrame.RightVector * offset.X) + (hrp.CFrame.UpVector * offset.Y) + (hrp.CFrame.LookVector * offset.Z)
				
				-- Create CFrame that looks AWAY from the player (opposite direction)
				local direction = (cameraPos - hrp.Position).Unit
				local lookAwayCF = CFrame.new(cameraPos, cameraPos + direction)

				CameraEvent:FireServer({
					cf = lookAwayCF
				})
			end
		end
		
		-- Update button text to show current position
		orbitButton.Text = "Orbit: " .. currentPos.name
		
		-- AS FAST AS POSSIBLE - no delay between positions
		task.wait()
		
		if check() then
			-- Go through table in reverse (opposite direction around player)
			currentOrbitIndex = currentOrbitIndex - 1
			if currentOrbitIndex < 1 then
				currentOrbitIndex = #orbitPositions
			end
		end
	end
	orbitButton.Text = "Orbit"
end



frontButton.MouseButton1Click:Connect(function()
