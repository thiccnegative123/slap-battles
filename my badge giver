-- Page tracking
local currentPage = 1
local totalPages = 13

local pageButtons = {
    {button1, button2, button3},
    {button5, button6, button7},
    {button8, button9, button10},
    {button11, button12, button13},
    {button14, button15, button16},
    {button17, button18, button19},
    {button20, button21, button22},
    {button23, button24, button25},
    {button26, button27, button28},
    {button29, button30, button31},
    {button32, button33, button34},
    {button35, button36, button37},
    {button38, nil, nil}
}

-- Function to show specific page
local function showPage(pageNum)
    for i, btns in ipairs(pageButtons) do
        local visible = (i == pageNum)
        for _, btn in ipairs(btns) do
            if btn then
                btn.Visible = visible
            end
        end
    end
    
    bb.Visible = (pageNum > 1)
    nb.Visible = (pageNum < totalPages)
    
    currentPage = pageNum
end

-- Navigation button events
nb.MouseButton1Click:Connect(function()
    if currentPage < totalPages then
        showPage(currentPage + 1)
    end
end)

bb.MouseButton1Click:Connect(function()
    if currentPage > 1 then
        showPage(currentPage - 1)
    end
end)


