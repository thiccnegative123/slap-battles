local Looping = false
local Ability1Spamming = false

local function FindPlayer(Search)
    Search = Search:lower()

    if Search == "" then
        return nil
    end

    if Search == "me" then
        return LocalPlayer
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player.Name:lower() == Search then
            return Player
        elseif Player.Name:lower():sub(1, #Search) == Search then
            return Player
        end
    end

    return nil
end

local function FireToPlayer(Player)
    if Player then
        Remote:FireServer("Ability3", Player)
        Status.Text = "Sent to " .. Player.Name
    end
end

local function FireToAll()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            FireToPlayer(Player)
            task.wait(0.1)
        end
    end

    Status.Text = "Sent to all other players!"
end

FireButton.MouseButton1Click:Connect(function()
    local Search = Input.Text:lower()

    if Search == "" then
        Status.Text = "Enter a username!"
        return
    end

    if Search == "all" then
        FireToAll()
        return
    end

    local Found = FindPlayer(Search)

    if Found then
        FireToPlayer(Found)
    else
        Status.Text = "Player not found!"
    end
end)

LoopButton.MouseButton1Click:Connect(function()
    local Search = Input.Text:lower()

    if Search == "" then
        Status.Text = "Enter a username!"
        return
    end

    if Search ~= "all" then
        local Found = FindPlayer(Search)

        if not Found then
            Status.Text = "Player not found!"
            return
        end
    end

    Looping = not Looping

    if Looping then
        LoopButton.Text = "Stop Loop"
        LoopButton.BackgroundColor3 = Color3.fromRGB(80, 160, 80)

        task.spawn(function()
            while Looping do
                local CurrentSearch = Input.Text:lower()

                if CurrentSearch == "all" then
                    for _, Player in ipairs(Players:GetPlayers()) do
                        if not Looping then
                            break
                        end

                        if Player ~= LocalPlayer then
                            FireToPlayer(Player)
                            task.wait(0.1)
                        end
                    end

                    Status.Text = "Looping all other players"
                else
                    local CurrentTarget = FindPlayer(CurrentSearch)

                    if CurrentTarget then
                        FireToPlayer(CurrentTarget)
                    else
                        Status.Text = "Player not found!"
                        Looping = false
                        break
                    end

                    task.wait(0.1)
                end
            end

            LoopButton.Text = "Start Loop"
            LoopButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            Status.Text = "Loop stopped"
        end)
    else
        LoopButton.Text = "Start Loop"
        LoopButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
        Status.Text = "Loop stopped"
    end
end)

