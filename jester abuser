local Looping = false
local Ability1Spamming = false

local function FindPlayer(Search)
    Search = Search:lower():gsub("^%s+", ""):gsub("%s+$", "")

    if Search == "" then
        return nil
    end

    if Search == "me" then
        return LocalPlayer
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player.Name:lower() == Search then
            return Player
        elseif Player.Name:lower():sub(1, #Search) == Search then
            return Player
        end
    end

    return nil
end

local function GetTargets()
    local Text = Input.Text:lower()
    local Targets = {}
    local FoundNames = {}

    if Text == "" then
        return Targets
    end

    if Text == "all" then
        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer then
                table.insert(Targets, Player)
            end
        end

        return Targets
    end

    for Name in string.gmatch(Text, "[^,]+") do
        local Player = FindPlayer(Name)

        if Player and not FoundNames[Player.Name] then
            FoundNames[Player.Name] = true
            table.insert(Targets, Player)
        end
    end

    return Targets
end

local function FireToPlayer(Player)
    if Player then
        Remote:FireServer("Ability3", Player)
        Status.Text = "Sent to " .. Player.Name
    end
end

local function FireToTargets()
    local Targets = GetTargets()

    if #Targets == 0 then
        Status.Text = "No valid players found!"
        return
    end

    for _, Player in ipairs(Targets) do
        FireToPlayer(Player)
        task.wait(0.1)
    end

    if #Targets == 1 then
        Status.Text = "Sent to " .. Targets[1].Name
    else
        Status.Text = "Sent to " .. #Targets .. " players!"
    end
end

FireButton.MouseButton1Click:Connect(function()
    if Input.Text:lower() == "" then
        Status.Text = "Enter a username!"
        return
    end

    FireToTargets()
end)

LoopButton.MouseButton1Click:Connect(function()
    local Targets = GetTargets()

    if #Targets == 0 then
        Status.Text = "No valid players found!"
        return
    end

    Looping = not Looping

    if Looping then
        LoopButton.Text = "Stop Loop"
        LoopButton.BackgroundColor3 = Color3.fromRGB(80, 160, 80)

        task.spawn(function()
            while Looping do
                local CurrentTargets = GetTargets()

                if #CurrentTargets == 0 then
                    Status.Text = "No valid players found!"
                    Looping = false
                    break
                end

                for _, Player in ipairs(CurrentTargets) do
                    if not Looping then
                        break
                    end

                    FireToPlayer(Player)
                    task.wait(0.1)
                end

                if #CurrentTargets == 1 then
                    Status.Text = "Looping " .. CurrentTargets[1].Name
                else
                    Status.Text = "Looping " .. #CurrentTargets .. " players"
                end
            end

            LoopButton.Text = "Start Loop"
            LoopButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            Status.Text = "Loop stopped"
        end)
    else
        LoopButton.Text = "Start Loop"
        LoopButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
        Status.Text = "Loop stopped"
    end
end)

